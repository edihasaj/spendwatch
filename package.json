{
  "name": "spendwatch",
  "version": "0.1.0",
  "description": "Token/$ leaderboards across coding agents (Claude Code, Codex). See which tool calls, shell commands, and prompts spend the most — so you know what to automate or fix.",
  "type": "module",
  "license": "MIT",
  "author": "Edi Hasaj",
  "homepage": "https://github.com/edihasaj/spendwatch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edihasaj/spendwatch.git"
  },
  "bugs": {
    "url": "https://github.com/edihasaj/spendwatch/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "coding-agent",
    "tokens",
    "cost",
    "observability",
    "cli",
    "bun",
    "llm",
    "anthropic",
    "openai"
  ],
  "bin": {
    "spendwatch": "src/cli.ts"
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "report": "bun src/cli.ts report",
    "watch": "bun src/cli.ts watch",
    "test": "bun test",
    "build": "bun build src/cli.ts --compile --outfile bin/spendwatch"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  }
}
